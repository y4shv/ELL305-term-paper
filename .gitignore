litmus/bin/
__pycache__/
*.pyc
.venv/

# ---- Generated data and figures --------------------------------------
# Raw CSVs ARE committed -- they are the experimental record.
# Figures are NOT: they regenerate from the CSVs by running the scripts.
figures/generated/
